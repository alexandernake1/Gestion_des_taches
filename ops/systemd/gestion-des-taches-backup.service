[Unit]
Description=Backup Taskina PostgreSQL database and media
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/ubuntu/Gestion_des_taches
Environment=BACKUP_RETENTION_DAYS=14
Environment=BACKUP_DIR=/var/backups/taskina
UMask=0077
Nice=10
ExecStart=/home/ubuntu/Gestion_des_taches/ops/backup-all.sh
