# Backend Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
USE_SQLITE=False
DB_HOST=postgres
DB_PORT=5432
DB_NAME=activity_tracker
DB_USER=postgres
DB_PASSWORD=postgres
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
ALLOWED_HOSTS=152.228.233.72,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://152.228.233.72
CSRF_TRUSTED_ORIGINS=http://152.228.233.72
APP_FRONTEND_URL=http://152.228.233.72
GOOGLE_OAUTH_CLIENT_ID=
# Cloudflare Turnstile (use a real widget pair outside local development)
TURNSTILE_SECRET_KEY=
# Temporary setting while the VPS is accessed directly by HTTP/IP.
# Set this to True as soon as HTTPS and a domain are configured.
JWT_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
JWT_COOKIE_SAMESITE=Lax
WEBSOCKET_ALLOW_QUERY_TOKEN=False
USE_IN_MEMORY_CHANNEL_LAYER=False
# Email local via le service Mailpit de docker-compose (interface : http://localhost:8025).
# En préproduction, remplacer ces valeurs par celles du fournisseur SMTP retenu.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Activity Control <no-reply@activity-control.local>
PASSWORD_RESET_TIMEOUT=3600

# Paiement : laisser désactivé tant qu'un fournisseur réel n'est pas intégré.
# Le mode test ne doit être utilisé que pour une recette interne contrôlée.
PAYMENT_PROVIDER=disabled
ALLOW_TEST_PAYMENT_SIMULATOR=False

# Frontend Configuration
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
