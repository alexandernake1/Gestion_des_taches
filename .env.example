# Copiez ce fichier vers .env, puis remplacez toutes les valeurs d'exemple.
# Les deux noms sont couverts par le certificat ; www redirige vers le domaine nu.
SITE_ADDRESS=taskina.net, www.taskina.net

# Django
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
DEBUG=False
ENABLE_API_DOCS=False
USE_SQLITE=False
ALLOWED_HOSTS=taskina.net,www.taskina.net

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=activity_tracker
DB_USER=activity_tracker
DB_PASSWORD=change-this-to-a-unique-database-password
CONN_MAX_AGE=600

# Même origine publique dans les trois variables.
CORS_ALLOWED_ORIGINS=https://taskina.net
CSRF_TRUSTED_ORIGINS=https://taskina.net
APP_FRONTEND_URL=https://taskina.net

# Cookies, proxy TLS et WebSocket
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
WEBSOCKET_ALLOW_QUERY_TOKEN=False
USE_IN_MEMORY_CHANNEL_LAYER=False
TRUSTED_PROXY_COUNT=2

# Redis et Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMTP transactionnel externe obligatoire avant ouverture publique.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Taskina <no-reply@taskina.net>
PASSWORD_RESET_TIMEOUT=3600

# Intégrations facultatives : renseigner les deux côtés d'une même intégration.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Aucun paiement réel n'est intégré à cette version.
PAYMENT_PROVIDER=disabled
ALLOW_TEST_PAYMENT_SIMULATOR=False

# Stockage objet facultatif. Sans bucket, les médias utilisent le volume Docker local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# Frontend et journalisation
VITE_API_URL=/api
LOG_LEVEL=INFO
