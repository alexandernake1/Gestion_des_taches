# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
USE_SQLITE=False
ALLOWED_HOSTS=152.228.233.72,localhost,127.0.0.1

# Database
DB_NAME=activity_tracker
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://152.228.233.72
CSRF_TRUSTED_ORIGINS=http://152.228.233.72
APP_FRONTEND_URL=http://152.228.233.72
GOOGLE_OAUTH_CLIENT_ID=
# Cloudflare Turnstile server-side secret (must match the frontend site key)
TURNSTILE_SECRET_KEY=
# Temporary setting while the VPS is accessed directly by HTTP/IP.
# Set this to True as soon as HTTPS and a domain are configured.
JWT_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
JWT_COOKIE_SAMESITE=Lax
WEBSOCKET_ALLOW_QUERY_TOKEN=False
USE_IN_MEMORY_CHANNEL_LAYER=False

# Email (valeurs locales avec le service Mailpit de docker-compose)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Activity Control <no-reply@activity-control.local>
PASSWORD_RESET_TIMEOUT=3600

# Paiement désactivé tant qu'un fournisseur réel n'est pas intégré.
PAYMENT_PROVIDER=disabled
ALLOW_TEST_PAYMENT_SIMULATOR=False

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# S3 (Optional - for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
