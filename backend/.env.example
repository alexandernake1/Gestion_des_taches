# Développement backend hors Docker. Le modèle de déploiement est ../.env.example.
SECRET_KEY=django-insecure-local-development-only
DEBUG=True
ENABLE_API_DOCS=True
USE_SQLITE=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
JWT_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
JWT_COOKIE_SAMESITE=Lax
WEBSOCKET_ALLOW_QUERY_TOKEN=False
USE_IN_MEMORY_CHANNEL_LAYER=True
TRUSTED_PROXY_COUNT=0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Taskina <no-reply@localhost>
PASSWORD_RESET_TIMEOUT=3600

PAYMENT_PROVIDER=test
ALLOW_TEST_PAYMENT_SIMULATOR=True

GOOGLE_OAUTH_CLIENT_ID=
TURNSTILE_SECRET_KEY=
LOG_LEVEL=INFO
